
# ── Quarto 빌드 산출물 ─────────────────────────────
/.quarto/
_site/
**/*.quarto_ipynb
# 개별 파일을 따로 렌더링할 때 .qmd 옆에 생기는 부산물
*_files/
# (_freeze/ 는 코드 실행 결과 캐시라 Quarto 권장대로 무시하지 않음)

# ── R / RStudio ───────────────────────────────────
.Rhistory
.RData
.Rapp.history
.Ruserdata
.Rproj.user/

# ── Python / Jupyter ──────────────────────────────
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# ── LaTeX 중간 파일 ───────────────────────────────
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg
*.nav
*.snm

# ── 운영체제가 만드는 파일 ────────────────────────
.DS_Store
._*
Thumbs.db
desktop.ini

# ── 에디터 임시·백업 파일 ─────────────────────────
*.swp
*.swo
*~
*.bak
*.tmp
.idea/

# ── 오피스 프로그램 잠금 파일 ─────────────────────
~$*
.~lock.*#

# ── 압축 파일 (Claude가 준 zip을 레포 안에 둘 때 대비) ──
*.zip
